# 示例环境变量，复制为 .env 后按需修改（或直接 export）
# Flask 会话密钥，生产环境务必换成随机长字符串
SECRET_KEY=请换成随机字符串

# 自有服务器：留空即用 SQLite（./data/app.db，WAL 模式）
# DATABASE_URL=

# Render：一键部署时由 render.yaml 自动注入 Postgres 连接串，无需手填
# DATABASE_URL=postgresql://...

# 投票截止时间（Asia/Shanghai），格式固定为 YYYY-MM-DD HH:MM
VOTE_DEADLINE=2026-10-07 23:59

# 本地开发端口
PORT=5000
